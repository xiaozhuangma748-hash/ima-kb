# ===== LLM API =====
# 默认使用 Agnes AI；如需切换 DeepSeek，把 AGNES_API_KEY/AGNES_BASE_URL/LLM_MODEL
# 改成 DeepSeek 的对应值即可（OpenAI 兼容 API）。
# 示例（DeepSeek）：
#   AGNES_API_KEY=sk-你的deepseek-key
#   AGNES_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
AGNES_API_KEY=sk-在这里填入你的key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash

# ===== 图像生成（Agnes Image 2.1 Flash）=====
# 独立配置：LLM 切换到 DeepSeek 后，图像 API 仍用 Agnes（DeepSeek 不提供图像生成）
# 未配置 IMAGE_API_KEY 时回退到 AGNES_API_KEY（向后兼容）
IMAGE_API_KEY=sk-在这里填入你的图像key
IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
IMAGE_MODEL=agnes-image-2.1-flash
IMAGE_SIZE=1024x1024
IMAGE_RESPONSE_FORMAT=url

# ===== 存储路径 =====
# 默认在项目根目录的 storage/ 下
STORAGE_PATH=./storage

# ===== 分块参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ===== RAG 参数 =====
RAG_TOP_K=6
LLM_MAX_TOKENS=1024

# ===== 对话记忆 =====
# 进入 LLM prompt 的最近消息条数（1 轮 = 2 条）
HISTORY_WINDOW=16
# 触发摘要压缩的阈值
HISTORY_COMPRESS_THRESHOLD=24
# 是否启用历史感知检索（1=启用，0=关闭）
HISTORY_AWARE_RETRIEVAL=1
# 是否启用跨会话记忆自动提取（1=启用，0=关闭）
ENABLE_CROSS_SESSION_EXTRACT=1
